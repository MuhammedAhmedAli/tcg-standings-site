---
import type { ScopeSummary } from "../data";
import { fmtPct, href } from "../lib/format";

interface Props {
  summary: ScopeSummary;
  /** Set on a format page: the all-time numbers to compare against. */
  overall?: ScopeSummary;
  /** Set on a format page: players whose first locals fell in this format. */
  newPlayers?: number;
  /** Bare stat line under a heading, with no frame (used in the home hero). */
  strip?: boolean;
}

const { summary: s, overall, newPlayers, strip = false } = Astro.props;
const tied = s.topWinners.length > 1;
---

<div class:list={["stats scope-stats", { "stats-strip": strip }]}>
  <div class="stat">
    <div class="label">Players</div>
    <div class="value">{s.players}</div>
    <div class="sub">{newPlayers === undefined ? `${s.entries} entries` : `${newPlayers} new to locals`}</div>
  </div>
  <div class="stat">
    <div class="label">Average turnout</div>
    <div class="value">{s.averageEntrants.toFixed(1)}</div>
    <div class="sub">Peak {s.peakEntrants}</div>
  </div>
  <div class="stat">
    <div class="label">Draw share</div>
    <div class="value">{fmtPct(s.drawShare)}</div>
    <div class="sub">
      {overall ? `${fmtPct(overall.drawShare)} overall` : <a href="#formats-h">Compare formats</a>}
    </div>
  </div>
  <div class="stat">
    <div class="label">Undefeated runs</div>
    <div class="value">{s.undefeated}</div>
    <div class="sub">{fmtPct(s.entries ? s.undefeated / s.entries : 0)} of entries</div>
  </div>
  <div class="stat">
    <div class="label">Most locals won</div>
    <div class:list={["value", "names", { tied }]}>
      {
        s.topWinners.length === 0
          ? "–"
          : s.topWinners.map((w, i) => <>{i > 0 && ", "}<a href={href(`/players/${w.slug}/`)}>{w.name}</a></>)
      }
    </div>
    <div class="sub">
      {s.topWins} {s.topWins === 1 ? "win" : "wins"}{tied && " each"}
    </div>
  </div>
</div>

<style>
  .scope-stats {
    margin-top: 32px;
  }
  .value.names {
    font-size: 26px;
  }

  /* Strip: a hairline stat line with no frame, so the hero has one card (the leader). */
  .stats.stats-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: auto;
    padding-top: 20px;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: none;
  }
  .stats-strip .stat {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
  }
  .stats-strip .stat .value {
    order: -1;
    font-size: 24px;
    margin: 0 0 2px;
  }
  .stats-strip .stat .label {
    font-size: 12.5px;
    color: var(--faint);
  }
  .stats-strip .stat .sub {
    display: none;
  }
  .stats-strip .value.names,
  .stats-strip .value.names.tied {
    font-size: 24px;
  }
  .value.names.tied {
    font-size: 20px;
    line-height: 1.3;
  }
  .value.names a {
    color: inherit;
    white-space: nowrap;
  }
  .sub a {
    color: var(--accent-soft);
  }
  @media (max-width: 860px) {
    .stats.stats-strip {
      margin-top: 28px;
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 14px 28px;
    }
    .stats.stats-strip .stat {
      grid-column: auto;
      border: 0;
      padding: 0;
    }
    .stats-strip .stat .value,
    .stats-strip .value.names,
    .stats-strip .value.names.tied {
      font-size: 20px;
      margin: 0 0 2px;
    }
    .value.names {
      font-size: 22px;
      white-space: normal;
    }
    .value.names.tied {
      font-size: 18px;
    }
  }
</style>
