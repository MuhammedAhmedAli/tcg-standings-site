---
/*
 * Light/dark switch. Pattern from 21st.dev's "Sliding Icon Theme Switch" (one icon that shows the
 * current mode), rebuilt as a plain icon button to sit beside the search in the header.
 *
 * The icons are original drawings in the spirit of the sun and moon rock Pokémon, not official
 * artwork: a flared sun rock by day and a stone crescent by night. Drawn in the site's colours.
 * The theme itself is set before the first paint by the script at the top of Base.astro.
 */
---

<button type="button" class="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <defs>
      <mask id="tt-crescent" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
        <circle cx="11" cy="12.5" r="9" fill="#fff"></circle>
        <circle cx="16.2" cy="8.4" r="7.6" fill="#000"></circle>
      </mask>
    </defs>
    <!-- Day: a sun rock. Flared points around a round body, a dark band across the face. -->
    <g class="tt-sol">
      <path class="tt-flare" d="M12 .8 14.04 5.72 17.64 4.23 17.34 8.12 22.65 8.54 18.6 12 21.13 14.97 17.34 15.88 18.58 21.06 14.04 18.28 12 21.6 9.96 18.28 5.42 21.06 6.66 15.88 2.87 14.97 5.4 12 1.35 8.54 6.66 8.12 6.36 4.23 9.96 5.72Z"></path>
      <circle class="tt-body" cx="12" cy="12" r="6.6"></circle>
      <path class="tt-band" d="M6.6 11.1c1.6-.7 3.6-.5 5.4.5 1.8-1 3.8-1.2 5.4-.5v2.3c-1.6.6-3.6.4-5.4-.5-1.8.9-3.8 1.1-5.4.5z"></path>
      <circle class="tt-eye" cx="9.3" cy="12.2" r=".85"></circle>
      <circle class="tt-eye" cx="14.7" cy="12.2" r=".85"></circle>
    </g>
    <!-- Night: a moon rock. A stone crescent with one eye on its inner curve. -->
    <g class="tt-luna">
      <rect class="tt-stone" width="24" height="24" mask="url(#tt-crescent)"></rect>
      <path class="tt-lid" d="M4.3 13.9c1.2-1.5 2.9-2.2 4.6-1.9-.9 1.6-2.7 2.3-4.6 1.9z"></path>
      <circle class="tt-eye" cx="6.9" cy="13.1" r=".75"></circle>
      <path class="tt-brow" d="M4.4 11.6c1.3-1.1 3-1.5 4.6-1.1"></path>
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: none;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s,
      transform 160ms var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .theme-toggle:active {
    transform: scale(0.97);
  }
  svg {
    overflow: visible;
  }
  .tt-flare {
    fill: var(--bronze-mid);
  }
  .tt-body {
    fill: var(--accent);
  }
  .tt-band {
    fill: var(--ink);
  }
  .tt-stone {
    fill: var(--accent-soft);
  }
  .tt-eye {
    fill: var(--down);
  }
  .tt-lid {
    fill: var(--bg);
  }
  .tt-brow {
    fill: none;
    stroke: var(--bg);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tt-sol,
  .tt-luna {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 0.45s var(--ease),
      opacity 0.25s var(--ease);
  }
  /* Night is the default: the moon rock is up, the sun rock has set below. */
  .tt-sol {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global(:root[data-theme="light"]) .tt-sol {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme="light"]) .tt-luna {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .tt-sol,
    .tt-luna {
      transition: opacity 0.15s;
    }
  }
</style>

<script>
  import { applyTheme, currentTheme } from "../scripts/theme";

  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  if (button) {
    const label = () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      button.setAttribute("aria-label", `Switch to ${next} theme`);
      button.title = `Switch to ${next} theme`;
    };
    label();
    button.addEventListener("click", () => {
      applyTheme(currentTheme() === "dark" ? "light" : "dark", true);
      label();
    });
    document.addEventListener("themechange", label);
  }
</script>
