---
/*
 * Light/dark switch. Pattern from 21st.dev's "Sliding Icon Theme Switch" (one icon that shows the
 * current mode), rebuilt as a plain icon button to sit beside the search in the header.
 *
 * The icon is an original drawing: a capture ball, bronze on top. In daylight it gives off sun
 * rays; at night a shadow slides across it and leaves a crescent, with two small stars.
 * The theme itself is set before the first paint by the script at the top of Base.astro.
 */
---

<button type="button" class="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <defs>
      <mask id="tt-night" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
        <rect width="24" height="24" fill="#fff"></rect>
        <circle class="tt-shadow" cx="18.4" cy="6.2" r="5.6" fill="#000"></circle>
      </mask>
    </defs>
    <g class="tt-rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M12 1.6v1.9M12 20.5v1.9M1.6 12h1.9M20.5 12h1.9M4.65 4.65l1.35 1.35M18 18l1.35 1.35M4.65 19.35 6 18M18 6l1.35-1.35"></path>
    </g>
    <g mask="url(#tt-night)">
      <path class="tt-top" d="M5.6 12a6.4 6.4 0 0 1 12.8 0z"></path>
      <circle cx="12" cy="12" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M5.6 12h4.1M14.3 12h4.1" stroke="currentColor" stroke-width="1.5"></path>
      <circle class="tt-button" cx="12" cy="12" r="2.1" stroke="currentColor" stroke-width="1.5"></circle>
    </g>
    <g class="tt-stars" fill="currentColor">
      <path d="M19.2 2.4l.55 1.25 1.25.55-1.25.55-.55 1.25-.55-1.25-1.25-.55 1.25-.55z"></path>
      <circle cx="21.2" cy="8.6" r=".85"></circle>
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: none;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s,
      transform 160ms var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .theme-toggle:active {
    transform: scale(0.97);
  }
  svg {
    overflow: visible;
  }
  .tt-top {
    fill: var(--accent);
  }
  .tt-button {
    fill: var(--bg);
  }
  .tt-rays,
  .tt-stars,
  .tt-shadow {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 0.4s var(--ease),
      opacity 0.25s var(--ease);
  }
  /* Night (the default): shadow over the ball, stars out, rays tucked in. */
  .tt-rays {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
  /* Day: the shadow slides off to the top right, rays open out, stars go. */
  :global(:root[data-theme="light"]) .tt-rays {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme="light"]) .tt-shadow {
    transform: translate(9px, -9px);
  }
  :global(:root[data-theme="light"]) .tt-stars {
    opacity: 0;
    transform: scale(0.4);
  }
  @media (prefers-reduced-motion: reduce) {
    .tt-rays,
    .tt-stars,
    .tt-shadow {
      transition: opacity 0.15s;
    }
  }
</style>

<script>
  import { applyTheme, currentTheme } from "../scripts/theme";

  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  if (button) {
    const label = () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      button.setAttribute("aria-label", `Switch to ${next} theme`);
      button.title = `Switch to ${next} theme`;
    };
    label();
    button.addEventListener("click", () => {
      applyTheme(currentTheme() === "dark" ? "light" : "dark", true);
      label();
    });
    document.addEventListener("themechange", label);
  }
</script>
