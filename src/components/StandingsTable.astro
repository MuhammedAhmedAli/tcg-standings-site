---
import { fmtPct, fmtShortDate, fmtTop, href, ordinal } from "../lib/format";
import type { PlayerStats } from "../data";
import Move from "./Move.astro";

interface Props {
  standings: PlayerStats[];
  /** id of the heading that labels the table */
  labelledby: string;
  /** Places moved at the latest event (positive = climbed, null = new). Omit to hide movement. */
  movement?: Map<string, number | null>;
}
const { standings, labelledby, movement } = Astro.props;
const FORM = 5;

// Columns: key, label, numeric?, default sort direction when first clicked.
const cols = [
  { key: "pos", label: "#", num: true, dir: "ascending" },
  { key: "name", label: "Player", num: false, dir: "ascending" },
  { key: "points", label: "Points", num: true, dir: "descending" },
  { key: "events", label: "Events", num: true, dir: "descending" },
  { key: "record", label: "W-L-D", num: true, dir: "descending" },
  { key: "win", label: "Win rate", num: true, dir: "descending" },
  { key: "tie", label: "Tie rate", num: true, dir: "descending" },
  { key: "avg", label: "Avg finish", num: true, dir: "ascending" },
  { key: "form", label: "Form", num: true, dir: "ascending" },
  { key: "best", label: "Best", num: true, dir: "ascending" },
  { key: "firsts", label: "Locals won", num: true, dir: "descending" },
] as const;
---

  <div class="toolbar">
    <label class="field">
      Find a player
      <input id="filter" type="search" placeholder="Name" autocomplete="off" />
    </label>
    <label class="field">
      Played at least
      <select id="min-events">
        <option value="1">Any</option>
        <option value="3">3 events</option>
        <option value="5">5 events</option>
        <option value="10">10 events</option>
      </select>
    </label>
    <button type="button" id="more-stats" class="more-stats" aria-pressed="false" aria-controls="standings">More stats</button>
  </div>
  <p id="rate-note" class="rate-note" hidden>
    Sorted by a rate, so players with fewer than 3 events are hidden. <button type="button" id="show-everyone">Show everyone</button>
  </p>

  <div class="table-frame compact" id="standings-frame">
    <table id="standings" aria-labelledby={labelledby}>
      <thead>
        <tr>
          {
            cols.map((c) => (
              <th
                class:list={[`c-${c.key}`, { num: c.num, sticky: c.key === "name" }]}
                data-key={c.key}
                data-dir={c.dir}
                aria-sort={c.key === "pos" ? "ascending" : undefined}
                scope="col"
              >
                <button type="button">{c.label}</button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          standings.map((p, i) => (
            <tr
              data-name={p.name.toLowerCase()}
              data-events={p.events}
              data-pos={i + 1}
              data-points={p.points}
              data-record={p.wins * 1e6 + p.draws * 1e3 - p.losses}
              data-win={p.winRate}
              data-tie={p.tieRate}
              data-avg={p.averagePercentile}
              data-form={p.history.slice(-FORM).reduce((a, h) => a + h.rank / h.entrants, 0) / Math.min(FORM, p.history.length)}
              data-best={p.bestFinish}
              data-firsts={p.firsts}
            >
              <td class:list={["num pos c-pos", { "is-podium": i < 3 }]}>{i + 1}</td>
              <td class="sticky player c-name">
                <a href={href(`/players/${p.slug}/`)}>{p.name}</a>
                {movement && <Move delta={movement.get(p.name)} />}
              </td>
              <td class="num c-points">{p.points}</td>
              <td class="num c-events">{p.events}</td>
              <td class="num c-record">
                {p.wins}-{p.losses}-{p.draws}
              </td>
              <td class="num c-win">
                <span class="rate">
                  <span class="bar" aria-hidden="true">
                    <i style={`width:${(p.winRate * 100).toFixed(1)}%`} />
                  </span>
                  {fmtPct(p.winRate)}
                </span>
              </td>
              <td class="num c-tie">{fmtPct(p.tieRate)}</td>
              <td class="num c-avg" title={`Average place ${p.averageFinish.toFixed(1)}`}>
                {fmtTop(p.averagePercentile)}
              </td>
              <td class="num c-form">
                <span class="form" aria-label={`Last ${Math.min(FORM, p.history.length)} finishes, oldest first`}>
                  {p.history.slice(-FORM).map((h) => (
                    <span
                      class:list={["chip", { top: h.rank / h.entrants <= 0.25, podium: h.rank <= 3 }]}
                      title={`${fmtShortDate(h.date)}: ${ordinal(h.rank)} of ${h.entrants}`}
                    >
                      {h.rank}
                    </span>
                  ))}
                </span>
              </td>
              <td class="num c-best">{ordinal(p.bestFinish)}</td>
              <td class="num c-firsts">{p.firsts || <span class="muted">0</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p id="empty" class="muted" hidden>No players match that search. Clear the name or lower the event count.</p>

<style>
  .toolbar {
    margin-top: 20px;
  }
  .more-stats {
    display: none;
  }
  .rate-note {
    margin: -4px 0 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .rate-note button {
    all: unset;
    cursor: pointer;
    color: var(--accent-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rate-note button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /*
   * Phones: the table opens on rank, name, points and win rate, so it fits without sideways
   * scrolling. "More stats" brings back every column.
   */
  @media (max-width: 600px) {
    .toolbar {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
    }
    .toolbar :global(.field) {
      width: auto;
    }
    .toolbar :global(.field:first-child) {
      grid-column: 1 / -1;
    }
    .toolbar :global(.field select) {
      width: auto;
      min-width: 0;
    }
    .more-stats {
      display: inline-flex;
      align-items: center;
      align-self: end;
      justify-content: center;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 15px;
      cursor: pointer;
    }
    .more-stats[aria-pressed="true"] {
      border-color: var(--accent);
      color: var(--accent-soft);
    }
    .compact :global(:is(.c-events, .c-record, .c-tie, .c-avg, .c-form, .c-best, .c-firsts)) {
      display: none;
    }
    .compact :global(.rate) {
      grid-template-columns: 36px auto;
      gap: 8px;
    }
  }
  .form {
    display: inline-flex;
    gap: 4px;
    justify-content: flex-end;
  }
  .chip {
    min-width: 24px;
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    color: var(--faint);
    background: color-mix(in srgb, var(--line) 60%, transparent);
  }
  .chip.top {
    color: var(--ink);
  }
  .chip.podium {
    color: var(--accent-soft);
    background: color-mix(in srgb, var(--accent-soft) 16%, transparent);
  }
</style>

<script>
  const table = document.getElementById("standings") as HTMLTableElement;
  const tbody = table.tBodies[0]!;
  const rows = Array.from(tbody.rows);
  const filter = document.getElementById("filter") as HTMLInputElement;
  const minEvents = document.getElementById("min-events") as HTMLSelectElement;
  const empty = document.getElementById("empty")!;

  function applyFilter() {
    const q = filter.value.trim().toLowerCase();
    const min = Number(minEvents.value);
    let shown = 0;
    for (const r of rows) {
      const ok = r.dataset.name!.includes(q) && Number(r.dataset.events) >= min;
      r.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  }
  filter.addEventListener("input", applyFilter);

  // Rates from one or two events swamp the top of a rate sort (one 3-0 night = 100%), so sorting
  // by a rate raises "Played at least" to 3 until the reader changes it or sorts by something else.
  const RATE_KEYS = new Set(["win", "tie", "avg", "form"]);
  const RATE_MIN = "3";
  const note = document.getElementById("rate-note")!;
  let autoMin = false;
  const setAutoMin = (on: boolean) => {
    autoMin = on;
    note.hidden = !on;
  };
  minEvents.addEventListener("change", () => {
    setAutoMin(false);
    applyFilter();
  });
  document.getElementById("show-everyone")!.addEventListener("click", () => {
    minEvents.value = "1";
    setAutoMin(false);
    applyFilter();
  });
  const onSort = (key: string) => {
    if (RATE_KEYS.has(key) && minEvents.value === "1") {
      minEvents.value = RATE_MIN;
      setAutoMin(true);
      applyFilter();
    } else if (!RATE_KEYS.has(key) && autoMin) {
      minEvents.value = "1";
      setAutoMin(false);
      applyFilter();
    }
  };

  // Phones: "More stats" shows every column. Remember the choice on this device.
  const frame = document.getElementById("standings-frame")!;
  const more = document.getElementById("more-stats")!;
  const setMore = (on: boolean) => {
    frame.classList.toggle("compact", !on);
    more.setAttribute("aria-pressed", String(on));
    more.textContent = on ? "Fewer stats" : "More stats";
  };
  try {
    if (localStorage.getItem("standings-more") === "1") setMore(true);
  } catch {}
  more.addEventListener("click", () => {
    const on = more.getAttribute("aria-pressed") !== "true";
    setMore(on);
    try {
      localStorage.setItem("standings-more", on ? "1" : "0");
    } catch {}
  });

  for (const th of Array.from(table.tHead!.rows[0]!.cells)) {
    th.querySelector("button")!.addEventListener("click", () => {
      const key = th.dataset.key!;
      const current = th.getAttribute("aria-sort");
      const dir = current ? (current === "ascending" ? "descending" : "ascending") : th.dataset.dir!;
      for (const other of Array.from(th.parentElement!.children)) other.removeAttribute("aria-sort");
      th.setAttribute("aria-sort", dir);
      const sign = dir === "ascending" ? 1 : -1;
      const val = (r: HTMLTableRowElement) => r.dataset[key]!;
      const sorted = [...rows].sort((a, b) => {
        const cmp = key === "name" ? val(a).localeCompare(val(b)) : Number(val(a)) - Number(val(b));
        return cmp * sign || Number(a.dataset.pos) - Number(b.dataset.pos);
      });
      tbody.append(...sorted);
      onSort(key);
    });
  }
</script>
