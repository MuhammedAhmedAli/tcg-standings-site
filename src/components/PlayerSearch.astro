---
import { getSiteData } from "../lib/site-data";
import { href } from "../lib/format";

// Every player, best overall position first, so the top of the list is the likeliest match.
const { standings } = await getSiteData();
const players = standings.map((p) => [p.name, href(`/players/${p.slug}/`)]);
---

<div class="psearch" data-players={JSON.stringify(players)}>
  <button type="button" class="psearch-open" aria-label="Find a player" aria-expanded="false" aria-controls="psearch-panel">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
  </button>
  <div class="psearch-panel" id="psearch-panel">
    <label class="visually-hidden" for="psearch-input">Find a player</label>
    <input
      id="psearch-input"
      type="search"
      placeholder="Find a player"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="psearch-list"
    />
    <ul id="psearch-list" role="listbox" aria-label="Players" hidden></ul>
  </div>
</div>

<style>
  .psearch {
    position: relative;
  }
  .psearch-open {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: transform 160ms var(--ease);
  }
  .psearch-open:active {
    transform: scale(0.97);
  }
  .psearch-open:hover,
  .psearch-open[aria-expanded="true"] {
    color: var(--ink);
    background: var(--surface);
  }
  .psearch-panel {
    position: relative;
  }
  input {
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 0 12px;
    height: 40px;
    width: 200px;
    transition: border-color 0.15s;
  }
  input::placeholder {
    color: var(--faint);
  }
  input:hover {
    border-color: var(--faint);
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
  }
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    width: 260px;
    max-height: 320px;
    overflow-y: auto;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  ul :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 0 10px;
    border-radius: 6px;
    cursor: pointer;
  }
  ul :global(li[aria-selected="true"]) {
    background: var(--surface-2);
  }
  ul :global(li .mono) {
    color: var(--faint);
  }
  ul :global(li.none) {
    color: var(--faint);
    cursor: default;
  }
  @media (max-width: 720px) {
    .psearch {
      position: static;
    }
    .psearch-open {
      display: grid;
    }
    .psearch-panel {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      z-index: 20;
      padding: 12px 16px 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .psearch-panel.open {
      display: block;
      transition: opacity 200ms var(--ease), transform 200ms var(--ease);
    }
    /* Drops in from under the header when the magnifier is tapped. */
    @starting-style {
      .psearch-panel.open {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
    input {
      width: 100%;
      height: 44px;
      font-size: 16px;
    }
    ul {
      position: static;
      width: auto;
      margin-top: 8px;
      box-shadow: none;
      max-height: 60vh;
    }
    ul :global(li) {
      min-height: 44px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".psearch");
  if (root) {
    const players: [string, string][] = JSON.parse(root.dataset.players!);
    const input = root.querySelector<HTMLInputElement>("input")!;
    const list = root.querySelector<HTMLUListElement>("ul")!;
    const panel = root.querySelector<HTMLElement>(".psearch-panel")!;
    const open = root.querySelector<HTMLButtonElement>(".psearch-open")!;
    let matches: [string, string, number][] = [];
    let active = -1;

    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll("li[role=option]").forEach((li, j) => li.setAttribute("aria-selected", String(j === i)));
      if (i >= 0) {
        input.setAttribute("aria-activedescendant", `psearch-opt-${i}`);
        list.children[i]?.scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    };

    const close = () => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      setActive(-1);
    };

    const render = () => {
      const q = input.value.trim().toLowerCase();
      if (!q) return close();
      // Names that start with the query first, then any that contain it.
      const starts: typeof matches = [];
      const contains: typeof matches = [];
      players.forEach(([name, url], i) => {
        const at = name.toLowerCase().indexOf(q);
        if (at === 0) starts.push([name, url, i + 1]);
        else if (at > 0) contains.push([name, url, i + 1]);
      });
      matches = [...starts, ...contains].slice(0, 8);
      list.replaceChildren(
        ...(matches.length
          ? matches.map(([name, , pos], i) => {
              const li = document.createElement("li");
              li.id = `psearch-opt-${i}`;
              li.setAttribute("role", "option");
              li.innerHTML = `<span></span><span class="mono">#${pos}</span>`;
              li.firstChild!.textContent = name;
              return li;
            })
          : [Object.assign(document.createElement("li"), { className: "none", textContent: "No player by that name" })]),
      );
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      setActive(matches.length ? 0 : -1);
    };

    const go = (i: number) => {
      const m = matches[i];
      if (m) location.href = m[1];
    };

    input.addEventListener("input", render);
    input.addEventListener("focus", render);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (list.hidden) return render();
        const n = matches.length;
        if (n) setActive((active + (e.key === "ArrowDown" ? 1 : n - 1)) % n);
      } else if (e.key === "Enter") {
        e.preventDefault();
        go(active);
      } else if (e.key === "Escape") {
        if (!list.hidden) close();
        else if (panel.classList.contains("open")) toggle(false);
      }
    });
    // pointerdown so the choice lands before the input's blur closes the list.
    list.addEventListener("pointerdown", (e) => {
      const li = (e.target as Element).closest("li[role=option]");
      if (!li) return;
      e.preventDefault();
      go(Array.from(list.children).indexOf(li));
    });
    input.addEventListener("blur", () => setTimeout(close, 100));

    // Phones: the magnifier opens a full-width search row under the header.
    const toggle = (show: boolean) => {
      panel.classList.toggle("open", show);
      open.setAttribute("aria-expanded", String(show));
      if (show) input.focus();
      else {
        input.value = "";
        close();
        open.focus();
      }
    };
    open.addEventListener("click", () => toggle(!panel.classList.contains("open")));
  }
</script>
