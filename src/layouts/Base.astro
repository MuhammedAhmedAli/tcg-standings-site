---
import "../styles/global.css";
import { getSiteData } from "../lib/site-data";
import { fmtDate, href } from "../lib/format";
import PlayerSearch from "../components/PlayerSearch.astro";
import FormatsMenu from "../components/FormatsMenu.astro";
// Self-hosted, latin-only fonts: served from the same origin as the page, so no Google Fonts round trips.
// Pairing picked with UI UX Pro Max: Space Grotesk for headings, Inter for text and numbers.
// The "Fallback" faces are Arial stretched to each font's width and line metrics, so text painted
// before the web fonts arrive takes the same space and nothing jumps when they swap in.
import displayUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import textUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

const fontFaces = `
@font-face{font-family:"Space Grotesk";font-style:normal;font-display:swap;font-weight:300 700;src:url(${displayUrl}) format("woff2-variations")}
@font-face{font-family:"Inter";font-style:normal;font-display:swap;font-weight:100 900;src:url(${textUrl}) format("woff2-variations")}
@font-face{font-family:"Space Grotesk Fallback";src:local("Arial"),local("Liberation Sans"),local("Helvetica");size-adjust:108.67%;ascent-override:90.55%;descent-override:26.87%;line-gap-override:0%}
@font-face{font-family:"Inter Fallback";src:local("Arial"),local("Liberation Sans"),local("Helvetica");size-adjust:106.95%;ascent-override:90.58%;descent-override:22.55%;line-gap-override:0%}`;

interface Props {
  title: string;
  description?: string;
  section?: "standings" | "events" | "records";
  /** Slug of the format page being shown; marks the Formats menu as current. */
  format?: string;
}
const { title, description = "Jesters weekly locals: overall standings, player records and every event's results.", section, format } = Astro.props;
const { events } = await getSiteData();
const last = events[events.length - 1];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
  </head>
  <body>
    <div class="nav-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("/")}><span class="brand-mark" aria-hidden="true">J</span>Jesters Locals</a>
        <nav aria-label="Main">
          <a href={href("/")} aria-current={section === "standings" ? "page" : undefined}>Standings</a>
          <a href={href("/events/")} aria-current={section === "events" ? "page" : undefined}>Events</a>
          <a href={href("/records/")} aria-current={section === "records" ? "page" : undefined}>Records</a>
          <FormatsMenu current={format} />
        </nav>
        <PlayerSearch />
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>Jesters Locals · weekly results</span>
        {last && <span class="mono">{events.length} events · last {fmtDate(last.date)}</span>}
      </div>
    </footer>
    <script>
      import "../scripts/pinned-head";
      import "../scripts/nav-progress";
    </script>
  </body>
</html>

<style is:global>
  /* The page heading settles once on load. Visible from the first paint: no fade, no delay. */
  [data-enter] {
    animation: enter 0.35s var(--ease);
  }
  @keyframes enter {
    from {
      transform: translateY(6px);
    }
  }
</style>
