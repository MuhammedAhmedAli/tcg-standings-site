---
import "../styles/global.css";
import { getSiteData } from "../lib/site-data";
import { fmtDate, href } from "../lib/format";
import PlayerSearch from "../components/PlayerSearch.astro";
import FormatsMenu from "../components/FormatsMenu.astro";
// Self-hosted, latin-only fonts: served from the same origin as the page, so no Google Fonts round trips.
// Pairing chosen with UI UX Pro Max ("Sports/Fitness"): Barlow Condensed for headings, Barlow for text and numbers.
import text400Url from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import text500Url from "@fontsource/barlow/files/barlow-latin-500-normal.woff2?url";
import text600Url from "@fontsource/barlow/files/barlow-latin-600-normal.woff2?url";
import text700Url from "@fontsource/barlow/files/barlow-latin-700-normal.woff2?url";
import display500Url from "@fontsource/barlow-condensed/files/barlow-condensed-latin-500-normal.woff2?url";
import display600Url from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";

const face = (family: string, weight: number, url: string) =>
  `@font-face{font-family:"${family}";font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format("woff2")}`;
const fontFaces = [
  face("Barlow", 400, text400Url),
  face("Barlow", 500, text500Url),
  face("Barlow", 600, text600Url),
  face("Barlow", 700, text700Url),
  face("Barlow Condensed", 500, display500Url),
  face("Barlow Condensed", 600, display600Url),
].join("");

interface Props {
  title: string;
  description?: string;
  section?: "standings" | "events" | "records";
  /** Slug of the format page being shown; marks the Formats menu as current. */
  format?: string;
}
const { title, description = "Jesters weekly locals: overall standings, player records and every event's results.", section, format } = Astro.props;
const { events } = await getSiteData();
const last = events[events.length - 1];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href={text400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={display500Url} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("/")}><span class="brand-mark" aria-hidden="true">J</span>Jesters Locals</a>
        <nav aria-label="Main">
          <a href={href("/")} aria-current={section === "standings" ? "page" : undefined}>Standings</a>
          <a href={href("/events/")} aria-current={section === "events" ? "page" : undefined}>Events</a>
          <a href={href("/records/")} aria-current={section === "records" ? "page" : undefined}>Records</a>
          <FormatsMenu current={format} />
        </nav>
        <PlayerSearch />
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>Jesters Locals · weekly results</span>
        {last && <span class="mono">{events.length} events · last {fmtDate(last.date)}</span>}
      </div>
    </footer>
    <script>
      import "../scripts/pinned-head";
    </script>
  </body>
</html>

<style is:global>
  /* The page heading settles once on load. Visible from the first paint: no fade, no delay. */
  [data-enter] {
    animation: enter 0.35s var(--ease);
  }
  @keyframes enter {
    from {
      transform: translateY(6px);
    }
  }
</style>
