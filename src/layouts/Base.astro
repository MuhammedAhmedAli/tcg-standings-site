---
import "../styles/global.css";
import { getSiteData } from "../lib/site-data";
import { fmtDate, href } from "../lib/format";
import PlayerSearch from "../components/PlayerSearch.astro";
import FormatsMenu from "../components/FormatsMenu.astro";
// Self-hosted, latin-only fonts: served from the same origin as the page, so no Google Fonts round trips.
import soraUrl from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import figtreeUrl from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import mono400Url from "@fontsource/martian-mono/files/martian-mono-latin-400-normal.woff2?url";
import mono500Url from "@fontsource/martian-mono/files/martian-mono-latin-500-normal.woff2?url";

const fontFaces = `
@font-face{font-family:"Sora";font-style:normal;font-display:swap;font-weight:100 800;src:url(${soraUrl}) format("woff2-variations")}
@font-face{font-family:"Figtree";font-style:normal;font-display:swap;font-weight:300 900;src:url(${figtreeUrl}) format("woff2-variations")}
@font-face{font-family:"Martian Mono";font-style:normal;font-display:swap;font-weight:400;src:url(${mono400Url}) format("woff2")}
@font-face{font-family:"Martian Mono";font-style:normal;font-display:swap;font-weight:500;src:url(${mono500Url}) format("woff2")}`;

interface Props {
  title: string;
  description?: string;
  section?: "standings" | "events" | "records";
  /** Slug of the format page being shown; marks the Formats menu as current. */
  format?: string;
}
const { title, description = "Jesters weekly locals: overall standings, player records and every event's results.", section, format } = Astro.props;
const { events } = await getSiteData();
const last = events[events.length - 1];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href={soraUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono400Url} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("/")}><span class="brand-mark" aria-hidden="true">J</span>Jesters Locals</a>
        <nav aria-label="Main">
          <a href={href("/")} aria-current={section === "standings" ? "page" : undefined}>Standings</a>
          <a href={href("/events/")} aria-current={section === "events" ? "page" : undefined}>Events</a>
          <a href={href("/records/")} aria-current={section === "records" ? "page" : undefined}>Records</a>
          <FormatsMenu current={format} />
        </nav>
        <PlayerSearch />
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>Jesters Locals · weekly results</span>
        {last && <span class="mono">{events.length} events · last {fmtDate(last.date)}</span>}
      </div>
    </footer>
    <script>
      import "../scripts/pinned-head";
    </script>
  </body>
</html>

<style is:global>
  /* The page heading settles once on load. Visible from the first paint: no fade, no delay. */
  [data-enter] {
    animation: enter 0.35s var(--ease);
  }
  @keyframes enter {
    from {
      transform: translateY(6px);
    }
  }
</style>
