---
import Base from "../layouts/Base.astro";
import { getSiteData } from "../lib/site-data";
import { href } from "../lib/format";

const { standings } = await getSiteData();
// Everything the page needs per player, small enough to ship as one JSON blob.
const players = standings.map((p, i) => ({
  n: p.name,
  s: p.slug,
  pos: i + 1,
  pts: p.points,
  ev: p.events,
  w: p.wins,
  l: p.losses,
  d: p.draws,
  wr: p.winRate,
  tr: p.tieRate,
  avg: p.averagePercentile,
  won: p.firsts,
  t8: p.history.filter((h) => h.rank <= 8).length,
  h: p.history.map((h) => [h.date, h.rank]),
}));
// Row labels for the placeholder card shown until the script fills in the real one.
const skeletonRows = ["Position", "Points", "Locals played", "Win rate", "Tie rate", "Average finish", "Locals won", "Top 8s"];
---

<Base title="Compare players · Jesters Locals" description="Two Jesters Locals players side by side." section="standings">
  <a class="back" href={href("/")}>← All standings</a>
  <p class="eyebrow">All time · {standings.length} players</p>
  <h1 data-enter>Compare players</h1>
  <p class="lede">Season stats side by side, and how they finished on the nights they both played.</p>

  {/* Type-to-search, like the header search. Filled with the chosen pair by the script. */}
  <div class="pickers">
    <div class="field pick">
      <label for="pick-a">Player</label>
      <div class="pick-box">
        <input id="pick-a" type="search" placeholder="Search players" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="pick-a-list" />
        <ul id="pick-a-list" role="listbox" aria-label="Players" hidden></ul>
      </div>
    </div>
    <span class="vs" aria-hidden="true">vs</span>
    <div class="field pick">
      <label for="pick-b">Compare with</label>
      <div class="pick-box">
        <input id="pick-b" type="search" placeholder="Search players" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="pick-b-list" />
        <ul id="pick-b-list" role="listbox" aria-label="Players" hidden></ul>
      </div>
    </div>
  </div>

  <div id="cmp" class="cmp" aria-live="polite">
    <div class="cmp-names">
      <a id="name-a" class="cmp-name" href="#"><span class="skel" style="width:6ch"></span></a>
      <a id="name-b" class="cmp-name r" href="#"><span class="skel" style="width:6ch"></span></a>
    </div>
    {/* Same shape as the real rows, so nothing moves when the script swaps them in. */}
    <div class="cmp-card" id="rows" aria-busy="true">
      {
        skeletonRows.map((k) => (
          <div class="row">
            <span class="v"><span class="skel" style="width:3ch" /></span>
            <div class="mid">
              <span class="k">{k}</span>
              <div class="bar" aria-hidden="true"><i style="flex:1" /><i style="flex:1" /></div>
            </div>
            <span class="v r"><span class="skel" style="width:3ch" /></span>
          </div>
        ))
      }
    </div>

    <h2>On the same night</h2>
    <p class="muted" id="h2h-text"><span class="skel" style="width:100%"></span><span class="skel" style="width:60%"></span></p>
    <div class="split" id="h2h-bar" aria-hidden="true"><i class="on"></i><i></i></div>
  </div>
  <p id="same" class="muted" hidden>Pick two different players.</p>

  <script id="players" type="application/json" set:html={JSON.stringify(players)} />
</Base>

<style>
  .pickers {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 16px;
    margin-top: 32px;
  }
  .pick-box {
    position: relative;
  }
  .pick input {
    width: 100%;
  }
  /* Focusing selects the name, so typing replaces it; the browser's clear button isn't needed. */
  .pick input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .pick ul {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    max-height: 320px;
    overflow-y: auto;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px var(--shadow);
  }
  .pick ul :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 6px;
    font-size: 15px;
    color: var(--ink);
    cursor: pointer;
  }
  .pick ul :global(li[aria-selected="true"]) {
    background: var(--surface-2);
  }
  .pick ul :global(.pos),
  .pick ul :global(li.none) {
    color: var(--faint);
  }
  .pick ul :global(li.none) {
    cursor: default;
  }
  .vs {
    padding-bottom: 12px;
    font-size: 13px;
    color: var(--faint);
  }
  .cmp-names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 36px 0 16px;
  }
  .cmp-name {
    justify-self: start;
    font: 400 40px/1.05 var(--font-display);
    letter-spacing: -0.035em;
  }
  .cmp-name.r {
    justify-self: end;
    text-align: right;
  }
  .cmp-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .cmp-card :global(.row) {
    display: grid;
    grid-template-columns: 120px 1fr 120px;
    align-items: center;
    gap: 20px;
    padding: 14px 20px;
    border-top: 1px solid var(--line);
  }
  .cmp-card :global(.row:first-child) {
    border-top: 0;
  }
  .cmp-card :global(.v) {
    font-size: 16px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cmp-card :global(.v.r) {
    text-align: right;
  }
  .cmp-card :global(.v.best) {
    color: var(--ink);
    font-weight: 500;
  }
  .cmp-card :global(.mid) {
    display: grid;
    gap: 7px;
  }
  .cmp-card :global(.k) {
    font-size: 13px;
    color: var(--faint);
    text-align: center;
  }
  .cmp-card :global(.bar),
  .split {
    display: flex;
    gap: 3px;
    height: 4px;
  }
  .cmp-card :global(.bar i),
  .split i {
    display: block;
    border-radius: 2px;
    background: var(--line-strong);
  }
  .cmp-card :global(.bar i.on),
  .split i.on {
    background: var(--accent);
  }
  .split {
    height: 6px;
    margin-top: 14px;
  }
  #h2h-text {
    margin: 0;
  }
  #h2h-text :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .pickers {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .vs {
      display: none;
    }
    .cmp-name {
      font-size: 26px;
    }
    .cmp-card :global(.row) {
      grid-template-columns: 72px 1fr 72px;
      gap: 10px;
      padding: 12px 14px;
    }
    .cmp-card :global(.v) {
      font-size: 14px;
    }
  }
</style>

<script>
  import { fmtPct, fmtTop, href, ordinal } from "../lib/format";

  type P = {
    n: string; s: string; pos: number; pts: number; ev: number; w: number; l: number; d: number;
    wr: number; tr: number; avg: number; won: number; t8: number; h: [string, number][];
  };
  const players: P[] = JSON.parse(document.getElementById("players")!.textContent!);
  const bySlug = new Map(players.map((p) => [p.s, p]));
  /**
   * A search box that holds one chosen player. Typing lists matching names (names that start with
   * the query first, then any that contain it), same as the header search. Leaving the box without
   * choosing puts the current player's name back.
   */
  function picker(input: HTMLInputElement, list: HTMLUListElement, onPick: () => void) {
    let slug = "";
    let matches: P[] = [];
    let active = -1;

    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll("li[role=option]").forEach((li, j) => li.setAttribute("aria-selected", String(j === i)));
      if (i >= 0) {
        input.setAttribute("aria-activedescendant", `${list.id}-${i}`);
        list.children[i]?.scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    };
    const close = () => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      setActive(-1);
    };
    const show = () => {
      const q = input.value.trim().toLowerCase();
      if (!q || q === bySlug.get(slug)?.n.toLowerCase()) return close();
      const starts: P[] = [];
      const contains: P[] = [];
      for (const p of players) {
        const at = p.n.toLowerCase().indexOf(q);
        if (at === 0) starts.push(p);
        else if (at > 0) contains.push(p);
      }
      matches = [...starts, ...contains].slice(0, 8);
      list.replaceChildren(
        ...(matches.length
          ? matches.map((p, i) => {
              const li = document.createElement("li");
              li.id = `${list.id}-${i}`;
              li.setAttribute("role", "option");
              li.innerHTML = `<span></span><span class="pos">#${p.pos}</span>`;
              li.firstChild!.textContent = p.n;
              return li;
            })
          : [Object.assign(document.createElement("li"), { className: "none", textContent: "No player by that name" })]),
      );
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      setActive(matches.length ? 0 : -1);
    };
    const choose = (i: number) => {
      const p = matches[i];
      if (!p) return;
      set(p.s);
      close();
      input.blur();
      onPick();
    };
    const set = (s: string) => {
      slug = s;
      input.value = bySlug.get(s)?.n ?? "";
    };

    input.addEventListener("input", show);
    // Select the current name on focus, so typing replaces it straight away.
    input.addEventListener("focus", () => input.select());
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (list.hidden) return show();
        const n = matches.length;
        if (n) setActive((active + (e.key === "ArrowDown" ? 1 : n - 1)) % n);
      } else if (e.key === "Enter") {
        e.preventDefault();
        choose(active);
      } else if (e.key === "Escape") {
        close();
        set(slug);
      }
    });
    // pointerdown so the choice lands before the input's blur closes the list.
    list.addEventListener("pointerdown", (e) => {
      const li = (e.target as Element).closest("li[role=option]");
      if (!li) return;
      e.preventDefault();
      choose(Array.from(list.children).indexOf(li));
    });
    input.addEventListener("blur", () =>
      setTimeout(() => {
        close();
        set(slug);
      }, 100),
    );

    return {
      get value() {
        return slug;
      },
      set value(s: string) {
        set(s);
      },
    };
  }

  const pickA = picker(document.getElementById("pick-a") as HTMLInputElement, document.getElementById("pick-a-list") as HTMLUListElement, () => render());
  const pickB = picker(document.getElementById("pick-b") as HTMLInputElement, document.getElementById("pick-b-list") as HTMLUListElement, () => render());

  // better: 1 = higher wins, -1 = lower wins, 0 = neither (tie rate is a style, not a score).
  const rows: { k: string; get: (p: P) => number; fmt: (v: number) => string; better: 1 | -1 | 0 }[] = [
    { k: "Position", get: (p) => p.pos, fmt: ordinal, better: -1 },
    { k: "Points", get: (p) => p.pts, fmt: String, better: 1 },
    { k: "Locals played", get: (p) => p.ev, fmt: String, better: 1 },
    { k: "Win rate", get: (p) => p.wr, fmt: fmtPct, better: 1 },
    { k: "Tie rate", get: (p) => p.tr, fmt: fmtPct, better: 0 },
    { k: "Average finish", get: (p) => p.avg, fmt: fmtTop, better: -1 },
    { k: "Locals won", get: (p) => p.won, fmt: String, better: 1 },
    { k: "Top 8s", get: (p) => p.t8, fmt: String, better: 1 },
  ];

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

  function render() {
    const a = bySlug.get(pickA.value)!;
    const b = bySlug.get(pickB.value)!;
    const params = new URLSearchParams({ a: a.s, b: b.s });
    history.replaceState(null, "", `?${params}`);
    const same = a.s === b.s;
    document.getElementById("cmp")!.hidden = same;
    document.getElementById("same")!.hidden = !same;
    if (same) return;

    for (const [id, p] of [["name-a", a], ["name-b", b]] as const) {
      const el = document.getElementById(id) as HTMLAnchorElement;
      el.textContent = p.n;
      el.href = href(`/players/${p.s}/`);
    }

    const card = document.getElementById("rows")!;
    card.removeAttribute("aria-busy");
    card.innerHTML = rows
      .map((r) => {
        const va = r.get(a), vb = r.get(b);
        const aw = r.better !== 0 && (r.better > 0 ? va > vb : va < vb);
        const bw = r.better !== 0 && (r.better > 0 ? vb > va : vb < va);
        // Bar shares: for "lower is better" rows compare the inverses so the better side gets more.
        const sa = r.better < 0 ? 1 / Math.max(va, 1e-9) : va;
        const sb = r.better < 0 ? 1 / Math.max(vb, 1e-9) : vb;
        const fa = sa + sb > 0 ? (sa / (sa + sb)) * 100 : 50;
        return `<div class="row">
          <span class="v${aw ? " best" : ""}">${esc(r.fmt(va))}</span>
          <div class="mid"><span class="k">${r.k}</span>
            <div class="bar" aria-hidden="true"><i class="${aw ? "on" : ""}" style="flex:${fa}"></i><i class="${bw ? "on" : ""}" style="flex:${100 - fa}"></i></div></div>
          <span class="v r${bw ? " best" : ""}">${esc(r.fmt(vb))}</span>
        </div>`;
      })
      .join("");

    // Nights both played: who finished higher.
    const rankB = new Map(b.h);
    let ab = 0, ba = 0;
    for (const [date, ra] of a.h) {
      const rb = rankB.get(date);
      if (rb === undefined) continue;
      if (ra < rb) ab++;
      else ba++;
    }
    const shared = ab + ba;
    const text = document.getElementById("h2h-text")!;
    const bar = document.getElementById("h2h-bar")!;
    bar.style.display = shared === 0 ? "none" : "";
    if (shared === 0) {
      text.textContent = "They haven't played the same locals yet.";
      return;
    }
    const times = (n: number) => `<strong>${n}</strong> ${n === 1 ? "time" : "times"}`;
    text.innerHTML = `Both played <strong>${shared}</strong> of the same locals. ${esc(a.n)} finished higher ${times(ab)}, ${esc(b.n)} ${times(ba)}. There's no per-match data, so this compares final places, not games against each other.`;
    const [ia, ib] = Array.from(bar.children) as HTMLElement[];
    ia!.style.flex = String(ab);
    ib!.style.flex = String(ba);
  }

  const q = new URLSearchParams(location.search);
  pickA.value = bySlug.has(q.get("a") ?? "") ? q.get("a")! : players[0]!.s;
  const fallbackB = players.find((p) => p.s !== pickA.value)!.s;
  pickB.value = bySlug.has(q.get("b") ?? "") && q.get("b") !== pickA.value ? q.get("b")! : fallbackB;
  render();
</script>
