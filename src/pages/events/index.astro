---
import Base from "../../layouts/Base.astro";
import { getSiteData } from "../../lib/site-data";
import { fmtDate, href } from "../../lib/format";

const { events, standings } = await getSiteData();
const slugOf = new Map(standings.map((p) => [p.name, p.slug]));
const rows = [...events].reverse();
---

<Base title="Events · Jesters Locals" section="events">
  <p class="eyebrow">{events.length} weeks</p>
  <h1 data-enter>Every locals</h1>
  <p class="lede">Each week's winner and turnout, newest first. Open a date for the full results.</p>
  <div class="table-frame" style="margin-top:40px">
    <table>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col" class="num">Players</th>
          <th scope="col">Winner</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((e) => (
            <tr>
              <td class="date">
                <a href={href(`/events/${e.date}/`)}>{fmtDate(e.date)}</a>
              </td>
              <td class="num">{e.entrants}</td>
              <td class="player">
                <a href={href(`/players/${slugOf.get(e.winner)}/`)}>{e.winner}</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>
