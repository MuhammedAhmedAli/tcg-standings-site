---
import Base from "../../layouts/Base.astro";
import PlacementChart from "../../components/PlacementChart.astro";
import SeasonGrid from "../../components/SeasonGrid.astro";
import FinishBreakdown from "../../components/FinishBreakdown.astro";
import Milestones from "../../components/Milestones.astro";
import { getSiteData } from "../../lib/site-data";
import { fmtDate, fmtPct, fmtShortDate, fmtTop, href, ordinal, plural } from "../../lib/format";
import type { Streak } from "../../data";
import type { PlayerStats } from "../../data";

export async function getStaticPaths() {
  const { standings } = await getSiteData();
  return standings.map((player) => ({ params: { slug: player.slug }, props: { player } }));
}

const { player } = Astro.props as { player: PlayerStats };
const { position, standings, formats, formatOf, streaks, events, rounds } = await getSiteData();
// This player's line in each format they played, newest format first.
const byFormat = [...formats]
  .reverse()
  .flatMap((f) => {
    const i = f.standings.findIndex((p) => p.name === player.name);
    return i === -1 ? [] : [{ format: f, stats: f.standings[i]!, pos: i + 1, of: f.standings.length }];
  });
const pos = position.get(player.name)!;
const history = [...player.history].reverse();
const st = streaks.get(player.name)!;
const span = (s: Streak) =>
  s.best === 0 ? "None yet" : s.current === s.best ? "Ongoing" : s.best === 1 ? fmtDate(s.start!) : `${fmtShortDate(s.start!)} to ${fmtDate(s.end!)}`;
const streakTiles = [
  { label: "Attendance streak", s: st.attendance, unit: ["local", "locals"], note: "in a row" },
  { label: "Top-8 run", s: st.top8, unit: ["finish", "finishes"], note: "in a row" },
  { label: "Undefeated run", s: st.undefeated, unit: ["night", "nights"], note: "in a row" },
];
const LATEST = 5;
const recent = history.slice(0, LATEST);
const recentPct = recent.reduce((a, h) => a + h.rank / h.entrants, 0) / recent.length;
---

<Base title={`${player.name} · Jesters Locals`} description={`${player.name} at Jesters Locals: ${plural(player.events, "event")}, ${fmtPct(player.winRate)} win rate.`} section="standings">
  <a class="back" id="back" href={href("/")} data-formats={JSON.stringify(formats.map((f) => [f.slug, f.name]))}>← All standings</a>
  <p class="eyebrow">{ordinal(pos)} of {standings.length} overall</p>
  <h1 data-enter>{player.name}</h1>
  <p class="lede">
    {plural(player.events, "event")}, {player.firstEvent === player.lastEvent ? `on ${fmtDate(player.firstEvent)}` : `from ${fmtDate(player.firstEvent)} to ${fmtDate(player.lastEvent)}`}.
    <a class="compare" href={href(`/compare/?a=${player.slug}`)}>Compare with another player →</a>
  </p>

  <div class="stats">
    <div class="stat">
      <div class="label">Win rate</div>
      <div class="value">{fmtPct(player.winRate)}</div>
      <div class="sub">{player.wins} of {plural(player.matches, "match", "matches")}</div>
    </div>
    <div class="stat">
      <div class="label">Tie rate</div>
      <div class="value">{fmtPct(player.tieRate)}</div>
      <div class="sub">{plural(player.draws, "draw")}</div>
    </div>
    <div class="stat">
      <div class="label">Record</div>
      <div class="value">{player.wins}-{player.losses}-{player.draws}</div>
      <div class="sub">{player.points} points</div>
    </div>
    <div class="stat">
      <div class="label">Average finish</div>
      <div class="value">{fmtTop(player.averagePercentile)}</div>
      <div class="sub">Avg place {player.averageFinish.toFixed(1)} · best {ordinal(player.bestFinish)}</div>
    </div>
    <div class="stat">
      <div class="label">Locals won</div>
      <div class="value">{player.firsts}</div>
      <div class="sub">of {player.events} played</div>
    </div>
  </div>

  {/* Quick jump to each section; stays under the top of the window and marks where you are. */}
  <nav class="jump" aria-label="On this page">
    <div class="jump-track">
      {
        [
          ["season", "Season"],
          ["finishes-h", "Where they finish"],
          ["latest-h", "Latest"],
          ["streaks", "Streaks"],
          ["milestones", "Milestones"],
          ...(byFormat.length > 0 ? [["by-format", "By format"]] : []),
          ["by-week", "By week"],
        ].map(([id, label]) => <a href={`#${id}`}>{label}</a>)
      }
      <span class="jump-mark" aria-hidden="true"></span>
    </div>
  </nav>

  <h2 id="season">Season</h2>
  <SeasonGrid history={player.history} events={events} formats={formats} formatOf={formatOf} />

  <h2 id="finishes-h">Where they finish</h2>
  <FinishBreakdown history={player.history} />

  <div class="latest-head">
    <h2 id="latest-h">Latest finishes</h2>
    <button type="button" class="more-cols" id="more-cols" aria-pressed="false" aria-controls="finishes">More stats</button>
    {
      history.length > LATEST && (
        <p class="muted form-note">
          Last {LATEST}: <strong>{fmtTop(recentPct)}</strong> on average, against {fmtTop(player.averagePercentile)} overall
        </p>
      )
    }
  </div>
  <div class="table-frame compact" id="finishes" data-collapsed={history.length > LATEST ? "" : undefined}>
    <table aria-labelledby="latest-h">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Format</th>
          <th scope="col" class="num">Place</th>
          <th scope="col" class="num extra">Of field</th>
          <th scope="col" class="num">W-L-D</th>
          <th scope="col" class="num extra">Points</th>
          <th scope="col" class="num extra">OWP</th>
          <th scope="col" class="num extra">OOWP</th>
        </tr>
      </thead>
      <tbody>
        {
          history.map((h, i) => (
            <tr class:list={{ more: i >= LATEST }}>
              <td class="date">
                <a href={href(`/events/${h.date}/`)}>{fmtDate(h.date)}</a>
              </td>
              <td class="muted">{formatOf.get(h.date)?.name ?? "–"}</td>
              <td class:list={["num pos", { "is-podium": h.rank <= 3 }]}>
                {ordinal(h.rank)} <span class="muted">/ {h.entrants}</span>
              </td>
              <td class="num extra">{fmtTop(h.rank / h.entrants)}</td>
              <td class="num">
                {h.wins}-{h.losses}-{h.draws}
              </td>
              <td class="num extra">{h.wins * 3 + h.draws}</td>
              <td class="num extra">{h.owp == null ? "–" : `${h.owp.toFixed(2)}%`}</td>
              <td class="num extra">{h.oowp == null ? "–" : `${h.oowp.toFixed(2)}%`}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {
    history.length > LATEST && (
      <button type="button" class="show-all" id="show-all" aria-controls="finishes" aria-expanded="false">
        Show all {history.length} events
      </button>
    )
  }


  <h2 id="streaks">Streaks</h2>
  <div class="stats streaks">
    {
      streakTiles.map(({ label, s, unit }) => (
        <div class="stat">
          <div class="label">{label}</div>
          <div class="value">
            {s.best}
            <span class="unit">{unit[s.best === 1 ? 0 : 1]}</span>
          </div>
          <div class="sub">
            {span(s)}
            {s.current > 0 && s.current !== s.best && ` · current ${s.current}`}
          </div>
        </div>
      ))
    }
    <div class="stat">
      <div class="label">Undefeated nights</div>
      <div class="value">{st.undefeatedCount}</div>
      <div class="sub">of {player.events} played</div>
    </div>
  </div>

  <h2 id="milestones">Milestones</h2>
  <Milestones history={player.history} rounds={rounds} />

  {
    byFormat.length > 0 && (
      <>
        <h2 id="by-format">By format</h2>
        <div class="table-frame">
          <table>
            <thead>
              <tr>
                <th scope="col">Format</th>
                <th scope="col" class="num">Position</th>
                <th scope="col" class="num">Events</th>
                <th scope="col" class="num">W-L-D</th>
                <th scope="col" class="num">Win rate</th>
                <th scope="col" class="num">Tie rate</th>
                <th scope="col" class="num">Avg finish</th>
                <th scope="col" class="num">Best</th>
              </tr>
            </thead>
            <tbody>
              {byFormat.map(({ format, stats, pos, of }) => (
                <tr>
                  <td class="player">
                    <a href={href(`/formats/${format.slug}/`)}>{format.name}</a>
                  </td>
                  <td class:list={["num pos", { "is-podium": pos <= 3 }]}>
                    {ordinal(pos)} <span class="muted">/ {of}</span>
                  </td>
                  <td class="num">{stats.events}</td>
                  <td class="num">
                    {stats.wins}-{stats.losses}-{stats.draws}
                  </td>
                  <td class="num">{fmtPct(stats.winRate)}</td>
                  <td class="num">{fmtPct(stats.tieRate)}</td>
                  <td class="num" title={`Average place ${stats.averageFinish.toFixed(1)}`}>
                    {fmtTop(stats.averagePercentile)}
                  </td>
                  <td class="num">{ordinal(stats.bestFinish)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <h2 id="by-week">Finish by week</h2>
  <PlacementChart history={player.history} />

</Base>

<style>
  /* Sticky section bar. Tables' pinned header rows sit just below it (--sticky-top). */
  :global(:root) {
    --sticky-top: 49px;
  }
  .jump {
    position: sticky;
    top: 0;
    z-index: 6;
    margin: 40px 0 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .jump-track {
    position: relative;
    display: flex;
    gap: 4px;
    height: 48px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump-track::-webkit-scrollbar {
    display: none;
  }
  .jump a {
    display: flex;
    align-items: center;
    flex: none;
    padding: 0 10px;
    font-size: 14px;
    color: var(--muted);
    background: none;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .jump a:first-child {
    padding-left: 0;
  }
  .jump a:hover,
  .jump a[aria-current="true"] {
    color: var(--ink);
  }
  /* Bronze underline that slides to the section in view. */
  .jump-mark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 2px;
    background: var(--accent-soft);
    transform-origin: left;
    opacity: 0;
    transition: transform 0.3s var(--ease), opacity 0.2s;
  }
  h2[id],
  .latest-head h2 {
    scroll-margin-top: 72px;
  }
  .compare {
    margin-left: 6px;
    color: var(--accent-soft);
    white-space: nowrap;
  }
  .streaks {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 20px;
  }
  .unit {
    font-family: var(--font-text);
    font-size: 15px;
    letter-spacing: 0;
    color: var(--muted);
    margin-left: 6px;
  }
  @media (max-width: 860px) {
    .streaks {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .latest-head h2 {
    margin-bottom: 0;
  }
  .form-note {
    margin: 0;
    font-size: 14px;
  }
  .form-note strong {
    color: var(--ink);
    font-weight: 500;
  }
  #finishes[data-collapsed] .more {
    display: none;
  }
  /* "Show all events": the extra rows fade in rather than appearing at once. */
  #finishes .more {
    transition: opacity 200ms var(--ease);
  }
  @starting-style {
    #finishes:not([data-collapsed]) .more {
      opacity: 0;
    }
  }
  .more-cols,
  .show-all {
    transition: transform 160ms var(--ease);
  }
  .more-cols:active,
  .show-all:active {
    transform: scale(0.97);
  }
  .more-cols {
    display: none;
  }
  /* Phones: date, format, place and record; "More stats" adds share of field, points and tiebreakers. */
  @media (max-width: 600px) {
    #finishes.compact .extra {
      display: none;
    }
    .more-cols {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      min-height: 40px;
      padding: 0 12px;
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 14px;
      cursor: pointer;
    }
    .more-cols[aria-pressed="true"] {
      border-color: var(--accent);
      color: var(--accent-soft);
    }
    .form-note {
      order: 3;
      flex-basis: 100%;
    }
  }
  .show-all {
    margin-top: 12px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.15s, transform 160ms var(--ease);
  }
  @media (hover: hover) {
    .show-all:hover {
      background: var(--surface-2);
    }
  }
</style>

<script>
  // Back link: if the reader came from a format's standings or an event, go back there instead.
  const back = document.getElementById("back") as HTMLAnchorElement;
  try {
    const from = new URL(document.referrer);
    if (from.origin === location.origin) {
      const names = new Map<string, string>(JSON.parse(back.dataset.formats!));
      const format = from.pathname.match(/\/formats\/([^/]+)\/$/);
      const event = from.pathname.match(/\/events\/(\d{4}-\d{2}-\d{2})\/$/);
      if (format && names.has(format[1]!)) {
        back.href = from.pathname;
        back.textContent = `← ${names.get(format[1]!)} standings`;
      } else if (event) {
        const d = new Date(`${event[1]}T00:00:00Z`);
        back.href = from.pathname;
        back.textContent = `← ${d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace("Sept", "Sep")} results`;
      }
    }
  } catch {}

  const frame = document.getElementById("finishes");
  const moreCols = document.getElementById("more-cols")!;
  moreCols.addEventListener("click", () => {
    const on = frame!.classList.toggle("compact") === false;
    moreCols.setAttribute("aria-pressed", String(on));
    moreCols.textContent = on ? "Fewer stats" : "More stats";
  });
  const button = document.getElementById("show-all");
  button?.addEventListener("click", () => {
    const collapsed = frame!.toggleAttribute("data-collapsed");
    button.setAttribute("aria-expanded", String(!collapsed));
    button.textContent = collapsed ? button.dataset.more! : "Show fewer";
  });
  if (button) button.dataset.more = button.textContent!.trim();

  // Section bar: mark the section in view and slide the underline under its link.
  {
    const track = document.querySelector<HTMLElement>(".jump-track");
    if (track) {
      const links = Array.from(track.querySelectorAll<HTMLAnchorElement>("a"));
      const mark = track.querySelector<HTMLElement>(".jump-mark")!;
      const heads = links.map((a) => document.getElementById(a.hash.slice(1))!);
      let current = -2;
      const sync = () => {
        // The last heading that has reached the area just under the bar.
        let i = -1;
        heads.forEach((h, j) => {
          if (h && h.getBoundingClientRect().top <= 96) i = j;
        });
        // At the very bottom, the last section counts even if its heading can't reach the top.
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) i = heads.length - 1;
        if (i === current) return;
        current = i;
        links.forEach((a, j) => a.setAttribute("aria-current", String(j === i)));
        const a = links[i];
        mark.style.opacity = a ? "1" : "0";
        if (!a) return;
        const pad = parseFloat(getComputedStyle(a).paddingLeft);
        mark.style.transform = `translateX(${a.offsetLeft + pad}px) scaleX(${a.offsetWidth - pad - parseFloat(getComputedStyle(a).paddingRight)})`;
        // Phones: keep the active link visible in the sideways-scrolling bar.
        const left = a.offsetLeft - (track.clientWidth - a.offsetWidth) / 2;
        track.scrollTo({ left, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      };
      addEventListener("scroll", sync, { passive: true });
      addEventListener("resize", () => {
        current = -2;
        sync();
      });
      sync();
    }
  }
</script>
