---
import Base from "../layouts/Base.astro";
import { getSiteData } from "../lib/site-data";
import StandingsTable from "../components/StandingsTable.astro";
import FormatPicker from "../components/FormatPicker.astro";
import ScopeStats from "../components/ScopeStats.astro";
import { fmtDate, fmtPct, href, ordinal } from "../lib/format";

const { standings, events, summary, formats, movement } = await getSiteData();
const latest = events[events.length - 1]!;
const podium = standings
  .flatMap((p) => p.history.filter((h) => h.date === latest.date && h.rank <= 3).map((h) => ({ ...h, name: p.name, slug: p.slug })))
  .sort((a, b) => a.rank - b.rank);
---

<Base title="Jesters Locals standings" section="standings">
  <p class="eyebrow">Season to date · {events.length} weeks</p>
  <h1 data-enter>Overall standings</h1>
  <p class="lede">
    {standings.length} players across every Jesters locals since {fmtDate(events[0]!.date)}. Three points a win, one a draw; level points are split by average OWP, then OOWP.
  </p>

  <ScopeStats summary={summary} />

  <section class="latest" aria-labelledby="latest-h">
    <div class="latest-head">
      <h2 id="latest-h">Latest locals</h2>
      <a class="mono" href={href(`/events/${latest.date}/`)}>{fmtDate(latest.date)} · {latest.entrants} players</a>
    </div>
    <ol class="podium">
      {
        podium.map((p) => (
          <li class:list={["place", `place-${p.rank}`]}>
            <span class="place-rank">{ordinal(p.rank)}</span>
            <a class="place-name" href={href(`/players/${p.slug}/`)}>
              {p.name}
            </a>
            <span class="mono muted">
              {p.wins}-{p.losses}-{p.draws}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <h2 id="table-h">All players</h2>
  <FormatPicker current={null} />
  <StandingsTable standings={standings} labelledby="table-h" movement={movement} />

  {
    formats.length > 0 && (
      <section aria-labelledby="formats-h">
        <h2 id="formats-h">By format</h2>
        <div class="table-frame">
          <table>
            <thead>
              <tr>
                <th scope="col">Format</th>
                <th scope="col" class="num">Weeks</th>
                <th scope="col" class="num">Players</th>
                <th scope="col" class="num">Avg turnout</th>
                <th scope="col" class="num">Draw share</th>
                <th scope="col" class="num">Undefeated</th>
              </tr>
            </thead>
            <tbody>
              {[...formats].reverse().map((f) => (
                <tr>
                  <td class="player">
                    <a href={href(`/formats/${f.slug}/`)}>{f.name}</a>
                  </td>
                  <td class="num">{f.summary.events}</td>
                  <td class="num">{f.summary.players}</td>
                  <td class="num">{f.summary.averageEntrants.toFixed(1)}</td>
                  <td class="num">{fmtPct(f.summary.drawShare)}</td>
                  <td class="num">{f.summary.undefeated}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Base>

<style>
  .latest {
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 22px 24px 24px;
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .latest-head h2 {
    margin: 0;
    font-size: 18px;
  }
  .latest-head a {
    color: var(--muted);
    min-height: 24px;
  }
  .podium {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .place {
    display: grid;
    gap: 6px;
    padding: 4px 20px;
    border-left: 1px solid var(--line);
  }
  .place:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .place-rank {
    font: 500 12px/1 var(--font-mono);
    color: var(--faint);
  }
  .place-1 .place-rank {
    color: var(--accent-soft);
  }
  .place-name {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    justify-self: start;
  }
  .place-1 .place-name {
    font-size: 30px;
  }
  @media (max-width: 640px) {
    .podium {
      grid-template-columns: 1fr;
    }
    .place,
    .place:first-child {
      border-left: 0;
      padding: 12px 0;
      border-top: 1px solid var(--line);
      grid-template-columns: 44px 1fr auto;
      align-items: baseline;
    }
    .place:first-child {
      border-top: 0;
    }
    .place-name,
    .place-1 .place-name {
      font-size: 19px;
    }
    .latest {
      margin-top: 24px;
      padding: 16px 16px 8px;
    }
    .podium {
      margin-top: 8px;
    }
    .place,
    .place:first-child {
      padding: 9px 0;
    }
    .latest-head h2 {
      font-size: 16px;
    }
  }
  h2#table-h {
    margin-top: 64px;
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    h2#table-h {
      margin-top: 40px;
    }
  }
</style>
