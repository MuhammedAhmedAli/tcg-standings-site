---
import Base from "../layouts/Base.astro";
import { getSiteData } from "../lib/site-data";
import StandingsTable from "../components/StandingsTable.astro";
import FormatPicker from "../components/FormatPicker.astro";
import { fmtDate, href, ordinal } from "../lib/format";

const { standings, events } = await getSiteData();
const latest = events[events.length - 1]!;
const podium = standings
  .flatMap((p) => p.history.filter((h) => h.date === latest.date && h.rank <= 3).map((h) => ({ ...h, name: p.name, slug: p.slug })))
  .sort((a, b) => a.rank - b.rank);
---

<Base title="Jesters Locals standings" section="standings">
  <p class="eyebrow">Season to date · {events.length} weeks</p>
  <h1 data-enter>Overall standings</h1>
  <p class="lede">
    {standings.length} players across every Jesters locals since {fmtDate(events[0]!.date)}. Three points a win, one a draw.
  </p>

  <section class="latest" aria-labelledby="latest-h">
    <div class="latest-head">
      <h2 id="latest-h">Latest locals</h2>
      <a class="mono" href={href(`/events/${latest.date}/`)}>{fmtDate(latest.date)} · {latest.entrants} players</a>
    </div>
    <ol class="podium">
      {
        podium.map((p) => (
          <li class:list={["place", `place-${p.rank}`]}>
            <span class="place-rank">{ordinal(p.rank)}</span>
            <a class="place-name" href={href(`/players/${p.slug}/`)}>
              {p.name}
            </a>
            <span class="mono muted">
              {p.wins}-{p.losses}-{p.draws}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <h2 id="table-h">All players</h2>
  <FormatPicker current={null} />
  <StandingsTable standings={standings} labelledby="table-h" />
</Base>

<style>
  .latest {
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 22px 24px 24px;
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .latest-head h2 {
    margin: 0;
    font-size: 18px;
  }
  .latest-head a {
    color: var(--muted);
    min-height: 24px;
  }
  .podium {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .place {
    display: grid;
    gap: 6px;
    padding: 4px 20px;
    border-left: 1px solid var(--line);
  }
  .place:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .place-rank {
    font: 500 12px/1 var(--font-mono);
    color: var(--faint);
  }
  .place-1 .place-rank {
    color: var(--accent-soft);
  }
  .place-name {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    justify-self: start;
  }
  .place-1 .place-name {
    font-size: 30px;
  }
  @media (max-width: 640px) {
    .podium {
      grid-template-columns: 1fr;
    }
    .place,
    .place:first-child {
      border-left: 0;
      padding: 12px 0;
      border-top: 1px solid var(--line);
      grid-template-columns: 44px 1fr auto;
      align-items: baseline;
    }
    .place:first-child {
      border-top: 0;
    }
    .place-name,
    .place-1 .place-name {
      font-size: 22px;
    }
  }
  h2#table-h {
    margin-top: 64px;
    margin-bottom: 0;
  }
</style>
