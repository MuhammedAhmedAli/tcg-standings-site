---
import Base from "../layouts/Base.astro";
import { getSiteData } from "../lib/site-data";
import StandingsTable from "../components/StandingsTable.astro";
import FormatPicker from "../components/FormatPicker.astro";
import ScopeStats from "../components/ScopeStats.astro";
import Move from "../components/Move.astro";
import { fmtDate, fmtPct, href, ordinal } from "../lib/format";

const { standings, events, summary, formats, movement, position } = await getSiteData();
const latest = events[events.length - 1]!;
const topFour = standings
  .flatMap((p) => p.history.filter((h) => h.date === latest.date && h.rank <= 4).map((h) => ({ ...h, name: p.name, slug: p.slug })))
  .sort((a, b) => a.rank - b.rank);
const [winner, ...chasers] = topFour;
const winnerWins = winner ? (standings.find((p) => p.name === winner.name)?.firsts ?? 1) : 0;

const leader = standings[0];
const second = standings[1];
const lead = leader && second ? leader.points - second.points : null;
---

<Base title="Jesters Locals standings" section="standings">
  <section class="hero" aria-label="Season overview">
    <div class="hero-main">
      <p class="eyebrow">Season to date · {events.length} weeks</p>
      <h1 data-enter>Overall standings</h1>
      <p class="lede">
        {standings.length} players across every Jesters locals since {fmtDate(events[0]!.date)}.
        <span class="lede-rules">Three points a win, one a draw; level points are split by average OWP, then OOWP.</span>
      </p>
      <a class="jump-table" href="#table-h">Jump to the table <span aria-hidden="true">↓</span></a>
      <ScopeStats summary={summary} strip />
    </div>
    {
      leader && (
        <aside class="leader" aria-labelledby="leader-h">
          <p class="leader-k" id="leader-h">Leading the season</p>
          <a class="leader-name" href={href(`/players/${leader.slug}/`)}>
            {leader.name}
          </a>
          <p class="leader-meta">
            {leader.wins}-{leader.losses}-{leader.draws} · {fmtPct(leader.winRate)} win rate · {leader.events} locals
          </p>
          <p class="leader-pts">
            <span class="leader-num">{leader.points}</span> points
          </p>
          {second && lead !== null && (
            <p class="leader-gap">
              {lead > 0 ? (
                <>
                  <b>+{lead}</b> over <a href={href(`/players/${second.slug}/`)}>{second.name}</a> in 2nd
                </>
              ) : (
                <>
                  Level with <a href={href(`/players/${second.slug}/`)}>{second.name}</a>, ahead on tiebreaks
                </>
              )}
            </p>
          )}
        </aside>
      )
    }
  </section>

  {
    winner && (
      <section class="latest" aria-labelledby="latest-h">
        <div class="latest-head">
          <h2 id="latest-h">Latest locals</h2>
          <a href={href(`/events/${latest.date}/`)}>{fmtDate(latest.date)} · {latest.entrants} players</a>
        </div>
        <div class="latest-body">
          <div class="winner">
            <span class="place-rank">1st</span>
            <a class="winner-name" href={href(`/players/${winner.slug}/`)}>
              {winner.name}
            </a>
            <span class="winner-note">{winnerWins === 1 ? "First locals win" : `${ordinal(winnerWins)} locals win`}</span>
            <span class="winner-meta">
              <span class="rec">
                {winner.wins}-{winner.losses}-{winner.draws}
              </span>
              <span>
                Now {ordinal(position.get(winner.name)!)} overall
                {movement && <Move delta={movement.get(winner.name)} />}
              </span>
            </span>
          </div>
          <ol class="chasers">
            {chasers.map((p) => (
              <li>
                <span class="place-rank">{ordinal(p.rank)}</span>
                <a class="chaser-name" href={href(`/players/${p.slug}/`)}>
                  {p.name}
                </a>
                <span class="rec">
                  {p.wins}-{p.losses}-{p.draws}
                </span>
                <span class="chaser-pos">
                  {ordinal(position.get(p.name)!)} overall
                  {movement && <Move delta={movement.get(p.name)} />}
                </span>
              </li>
            ))}
          </ol>
        </div>
        <a class="latest-all" href={href(`/events/${latest.date}/`)}>
          Full results for all {latest.entrants} players →
        </a>
      </section>
    )
  }

  <div class="table-head">
    <h2 id="table-h">All players</h2>
    <a href={href("/compare/")}>Compare players →</a>
  </div>
  <StandingsTable standings={standings} labelledby="table-h" movement={movement}>
    <FormatPicker current={null} slot="scope" />
  </StandingsTable>

  {
    formats.length > 0 && (
      <section aria-labelledby="formats-h">
        <h2 id="formats-h">By format</h2>
        <div class="table-frame">
          <table>
            <thead>
              <tr>
                <th scope="col">Format</th>
                <th scope="col" class="num">Weeks</th>
                <th scope="col" class="num">Players</th>
                <th scope="col" class="num">Avg turnout</th>
                <th scope="col" class="num">Draw share</th>
                <th scope="col" class="num">Undefeated</th>
              </tr>
            </thead>
            <tbody>
              {[...formats].reverse().map((f) => (
                <tr>
                  <td class="player">
                    <a href={href(`/formats/${f.slug}/`)} data-row-link>{f.name}</a>
                  </td>
                  <td class="num">{f.summary.events}</td>
                  <td class="num">{f.summary.players}</td>
                  <td class="num">{f.summary.averageEntrants.toFixed(1)}</td>
                  <td class="num">{fmtPct(f.summary.drawShare)}</td>
                  <td class="num">{f.summary.undefeated}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Hero: title and stat line on the left, the season leader on the right. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 40px;
    align-items: stretch;
  }
  .hero-main {
    display: flex;
    flex-direction: column;
  }
  .leader {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--leader-line);
    border-radius: 16px;
    padding: 28px 30px;
    background:
      radial-gradient(120% 90% at 85% 0%, var(--leader-glow), var(--leader-glow-2) 45%, transparent 70%),
      linear-gradient(180deg, var(--leader-top), var(--leader-bottom));
  }
  .leader p {
    margin: 0;
  }
  .leader-k {
    font: 500 12px/1 var(--font-data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .leader-name {
    justify-self: start;
    align-self: start;
    margin-top: 14px;
    font: 400 48px/1.05 var(--font-display);
    letter-spacing: -0.035em;
  }
  .leader-meta {
    margin-top: 8px !important;
    color: var(--muted);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .leader-pts {
    margin-top: auto !important;
    padding-top: 24px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--muted);
  }
  .leader-num {
    font: 500 64px/1 var(--font-display);
    letter-spacing: -0.04em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .leader-gap {
    margin-top: 10px !important;
    font-size: 14px;
    color: var(--muted);
  }
  .leader-gap b {
    color: var(--ink);
    font-weight: 500;
  }
  .leader-gap a {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .leader {
      padding: 20px 20px 18px;
    }
    .leader-name {
      font-size: 34px;
      margin-top: 10px;
    }
    .leader-meta {
      font-size: 14px;
    }
    .leader-pts {
      padding-top: 16px;
    }
    .leader-num {
      font-size: 44px;
    }
    .leader-gap {
      margin-top: 8px !important;
    }
  }

  /* Latest locals: the winner on the left, 2nd to 4th as a ranked list. */
  .latest {
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 22px 24px 0;
  }
  .table-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .table-head a {
    color: var(--muted);
    font-size: 14px;
  }
  @media (hover: hover) {
    .table-head a:hover {
      color: var(--ink);
    }
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .latest-head h2 {
    margin: 0;
    font-size: 18px;
  }
  .latest-head a {
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    min-height: 24px;
  }
  .latest-body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 32px;
    margin-top: 18px;
    padding-bottom: 20px;
  }
  .place-rank {
    font: 500 12px/1 var(--font-data);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .winner {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: 32px;
    border-right: 1px solid var(--line);
  }
  .winner .place-rank {
    color: var(--accent-soft);
  }
  .winner-name {
    align-self: start;
    font: 400 40px/1.05 var(--font-display);
    letter-spacing: -0.035em;
  }
  .winner-note {
    font-size: 13px;
    color: var(--accent-soft);
  }
  .winner-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    color: var(--muted);
    font-size: 14px;
  }
  .rec {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .chasers {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chasers li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 128px;
    align-items: baseline;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid var(--line);
  }
  .chasers li:first-child {
    border-top: 0;
    padding-top: 2px;
  }
  .chaser-name {
    justify-self: start;
    font: 400 20px/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }
  .chaser-pos {
    text-align: right;
    color: var(--faint);
    font-size: 13px;
    white-space: nowrap;
  }
  .latest-all {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin: 0 -24px;
    padding: 0 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    background: none;
  }
  @media (hover: hover) {
    .latest-all:hover {
      color: var(--ink);
    }
  }
  @media (max-width: 760px) {
    .latest {
      margin-top: 24px;
      padding: 16px 16px 0;
    }
    .latest-head h2 {
      font-size: 16px;
    }
    .latest-body {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 14px;
      padding-bottom: 12px;
    }
    .winner {
      padding: 0 0 14px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .winner-name {
      font-size: 30px;
    }
    .chasers li {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      padding: 9px 0;
    }
    .chasers li:first-child {
      padding-top: 0;
    }
    .chaser-name {
      font-size: 17px;
    }
    .chaser-pos {
      grid-column: 2 / -1;
      text-align: left;
      margin-top: -6px;
    }
    .latest-all {
      margin: 0 -16px;
      padding: 0 16px;
    }
  }
  h2#table-h {
    margin-top: 64px;
    margin-bottom: 0;
    scroll-margin-top: 16px;
  }
  .jump-table {
    display: none;
  }

  /*
   * Phones: the standings are what most people come for, so the season summary above them is
   * kept short. The scoring rules stay on wider screens; the leader card puts the points beside the name and
   * each latest-locals finisher fits on one line; and a link under the intro jumps straight to the table.
   */
  @media (max-width: 600px) {
    h2#table-h {
      margin-top: 36px;
    }
    .lede {
      font-size: 16px;
    }
    .lede-rules {
      display: none;
    }
    .jump-table {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      align-self: start;
      min-height: 36px;
      margin-top: 12px;
      padding: 0 14px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      font-size: 14px;
      color: var(--ink);
      background: var(--surface);
      transition: transform 160ms var(--ease);
    }
    .jump-table:active {
      transform: scale(0.97);
    }
    .hero {
      gap: 20px;
    }
    .leader {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 16px;
      padding: 16px 18px;
    }
    .leader-k,
    .leader-meta,
    .leader-gap {
      grid-column: 1 / -1;
    }
    .leader-name {
      grid-column: 1;
      margin-top: 8px;
      font-size: 28px;
    }
    .leader-pts {
      grid-column: 2;
      grid-row: 2;
      align-self: end;
      margin-top: 0 !important;
      padding-top: 0;
      gap: 6px;
      font-size: 14px;
    }
    .leader-num {
      font-size: 34px;
    }
    .leader-meta {
      margin-top: 6px !important;
      font-size: 13.5px;
    }
    .leader-gap {
      margin-top: 4px !important;
      font-size: 13.5px;
    }
    .latest {
      margin-top: 20px;
    }
    .winner {
      gap: 6px;
      padding-bottom: 12px;
    }
    .winner-name {
      font-size: 26px;
    }
    .chasers li {
      grid-template-columns: 30px minmax(0, 1fr) 52px 104px;
      gap: 8px;
      padding: 8px 0;
    }
    .chaser-name {
      font-size: 16px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 100%;
    }
    .chasers .rec {
      white-space: nowrap;
    }
    .chaser-pos {
      grid-column: auto;
      margin-top: 0;
      text-align: right;
    }
  }
</style>
